# ── BOT TOKEN ─────────────────────────────────────────────────────
# 1. Buka Telegram → chat @BotFather
# 2. Ketik /newbot → ikuti instruksi
# 3. Copy token di bawah ini
BOT_TOKEN=GANTI_DENGAN_TOKEN_BOT_BARU

# ── ADMIN ─────────────────────────────────────────────────────────
# Telegram User ID kamu (admin). Dapat dari @userinfobot
# Pisahkan koma jika lebih dari 1 admin: 12345,67890
ADMIN_IDS=8821874054

# ── INFO TOKO ─────────────────────────────────────────────────────
STORE_NAME=🎮 DigiStore
STORE_DESCRIPTION=Toko top up game terpercaya • Proses cepat & aman ✅

# ── PEMBAYARAN ────────────────────────────────────────────────────
# BCA (isi minimal satu metode pembayaran)
PAYMENT_BCA=1234567890
PAYMENT_BCA_NAME=Nama Pemilik

# OVO (kosongkan jika tidak dipakai)
PAYMENT_OVO=
PAYMENT_OVO_NAME=

# DANA (kosongkan jika tidak dipakai)
PAYMENT_DANA=
PAYMENT_DANA_NAME=

# QRIS: Upload foto QRIS kamu ke bot sekali, copy file_id-nya ke sini
# Cara dapat file_id: kirim /getfileid ke bot setelah bot jalan
QRIS_FILE_ID=

# ── DATABASE ──────────────────────────────────────────────────────
DB_PATH=data/sales.db

# ── ORDER ─────────────────────────────────────────────────────────
# Pesanan otomatis expire setelah N jam jika tidak ada bukti bayar
ORDER_EXPIRY_HOURS=24

# ── TRIPAY (upgrade nanti, tidak perlu diisi sekarang) ─────────────
PAYMENT_MODE=manual
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_SANDBOX=true
